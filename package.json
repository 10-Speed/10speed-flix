{
  "name": "10speed-flix",
  "version": "1.0.0",
  "author": "Rokas Anisas <rokas@10speed.lt>",
  "license": "MIT",
  "engineStrict": true,
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=4 < 5"
  },
  "scripts": {
    "start": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint:code": "eslint \"src/**/*.{js,jsx,json,ts,tsx}\"",
    "lint:ts": "yarn tsc --noEmit --skipLibCheck",
    "lint": "yarn lint:code && yarn lint:ts",
    "lint:fix": "eslint \"src/**/*.{js,jsx,json,ts,tsx}\" --fix && prettier . --write",
    "update": "yarn upgrade-interactive"
  },
  "devDependencies": {
    "@10speed/eslint-config-ten-speed-react": "^1.5.4",
    "@tanstack/react-query-devtools": "^5.77.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "8.57.1",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "5.5.4",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@tanstack/react-query": "^5.77.2",
    "axios": "^1.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.6.1"
  },
  "packageManager": "yarn@4.5.0"
}
